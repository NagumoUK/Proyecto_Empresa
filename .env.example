APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_ADMIN_EMAIL=

APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=es_PE

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
# Supabase > Connect > Session pooler; copy the host and username exactly.
DB_HOST=your-supabase-pooler-host
DB_PORT=5432
DB_DATABASE=postgres
DB_USERNAME=your-supabase-pooler-username
DB_PASSWORD=your-database-password
DB_SSLMODE=require

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=ably
# Add a new Ably Root key here. Never use a Subscribe-only key on the server.
# If empty, Laravel temporarily uses the log broadcaster and records a warning.
ABLY_KEY=your-ably-root-key
ABLY_TOKEN_EXPIRY=3600
FILESYSTEM_DISK=local
PROJECT_FILES_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"
MAIL_NOTIFICATION_TO=

# Free Gemini API is for testing with fictitious/anonymized data only.
# Google may use free-tier prompts and responses to improve its services.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Optional OpenAI provider settings for other AI features.
OPENAI_API_KEY=
OPENAI_STORE=false

# Generate and keep these VAPID keys stable; never commit populated values.
VAPID_SUBJECT=mailto:admin@example.com
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Optional generic outbound HTTP API client. Never commit real tokens.
EXTERNAL_API_BASE_URL=
EXTERNAL_API_TOKEN=
EXTERNAL_API_CONNECT_TIMEOUT=3
EXTERNAL_API_TIMEOUT=10

# Public Open-Meteo forecast endpoint; no API key or browser geolocation needed.
WEATHER_LOCATION="Lima, Perú"
WEATHER_LATITUDE=-12.0464
WEATHER_LONGITUDE=-77.0428
WEATHER_TIMEZONE=America/Lima
WEATHER_API_ENDPOINT=https://api.open-meteo.com/v1/forecast
